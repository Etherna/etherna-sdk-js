{
  "name": "@etherna/sdk-js",
  "version": "2.0.4",
  "description": "Etherna SDKs for operations on the network",
  "author": "Mattia Dalzocchio",
  "license": "LGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/Etherna/etherna-sdk-js"
  },
  "keywords": [
    "etherna",
    "clients",
    "swarm",
    "bee",
    "index",
    "gateway",
    "sso",
    "schema",
    "manifest",
    "serializer",
    "deserializer"
  ],
  "bugs": {
    "url": "https://etherna.atlassian.net/projects/ESJ"
  },
  "homepage": "https://github.com/etherna/etherna-sdk-js#readme",
  "type": "module",
  "files": [
    "dist"
  ],
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "pnpm tsup --watch",
    "build": "pnpm tsup  --minify --clean --sourcemap",
    "test": "pnpm vitest",
    "test-ui": "pnpm vitest --ui",
    "lint": "pnpm oxlint",
    "format": "pnpm oxfmt",
    "format:check": "pnpm oxfmt --check",
    "typecheck": "pnpm tsc --noEmit"
  },
  "peerDependencies": {
    "@ffmpeg/ffmpeg": ">=0.12",
    "@ffmpeg/util": ">=0.12",
    "axios": ">=1.9",
    "zod": ">=4.1"
  },
  "dependencies": {
    "@ffmpeg.wasm/core-mt": "0.13.2",
    "@ffmpeg.wasm/main": "0.13.1",
    "@ffmpeg/ffmpeg": "0.12.15",
    "@ffmpeg/util": "0.12.2",
    "@noble/hashes": "2.2.0",
    "@noble/secp256k1": "3.1.0",
    "axios": "1.15.2",
    "blurhash": "2.0.5",
    "crypto-ts": "1.0.2",
    "image-size": "^2.0.2",
    "jimp": "1.6.1",
    "uuid-random": "1.3.2",
    "viem": "2.48.4",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@total-typescript/ts-reset": "0.6.1",
    "@types/node": "25.6.0",
    "@types/wicg-file-system-access": "2023.10.7",
    "globals": "17.5.0",
    "oxfmt": "0.46.0",
    "oxlint": "1.61.0",
    "oxlint-tsgolint": "0.22.0",
    "tsup": "8.5.1",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "vite": "8.0.10",
    "vitest": "4.1.5"
  },
  "optionalDependencies": {
    "@vitest/ui": "4.1.4"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": []
    }
  },
  "packageManager": "pnpm@11.14.0"
}
